<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Piano Transcriber</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/vexflow@4.2.2/build/cjs/vexflow.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            900: '#14532d',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
        
        body {
            background-color: #0f172a;
            color: #f8fafc;
        }

        .glass-panel {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        #visualizer {
            width: 100%;
            height: 120px;
            background-color: #020617;
            border-radius: 0.5rem;
            box-shadow: inset 0 2px 4px 0 rgb(0 0 0 / 0.05);
        }

        #sheet-music-container {
            width: 100%;
            overflow-x: auto;
            background-color: white; /* Vexflow needs a white background */
            border-radius: 0.5rem;
            min-height: 200px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #333; /* Dark text for loading state on white bg */
        }
        
        #sheet-music-container svg {
            max-width: 100%;
        }

        /* Custom Scrollbar for sheet music */
        #sheet-music-container::-webkit-scrollbar {
            height: 8px;
        }
        #sheet-music-container::-webkit-scrollbar-track {
            background: #f1f1f1; 
            border-radius: 0 0 0.5rem 0.5rem;
        }
        #sheet-music-container::-webkit-scrollbar-thumb {
            background: #cbd5e1; 
            border-radius: 4px;
        }
        #sheet-music-container::-webkit-scrollbar-thumb:hover {
            background: #94a3b8; 
        }

        .pulse-animation {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: .5; }
        }
    </style>
</head>
<body class="min-h-screen p-4 md:p-8 flex flex-col items-center">

    <header class="text-center mb-10 w-full max-w-4xl">
        <h1 class="text-4xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-brand-500 to-teal-400 mb-4">
            Piano Transcriber Pro
        </h1>
        <p class="text-slate-400 text-lg">Upload monophonic audio and watch it transcribe in real-time</p>
    </header>

    <main class="w-full max-w-4xl grid grid-cols-1 gap-8">
        
        <!-- Controls Section -->
        <section class="glass-panel p-6 rounded-2xl shadow-xl flex flex-col md:flex-row gap-6 items-center justify-between">
            
            <div class="flex-1 w-full">
                <label class="block text-sm font-medium text-slate-300 mb-2" for="audio-upload">Upload Piano Audio (MP3/WAV)</label>
                <input type="file" id="audio-upload" accept="audio/mpeg, audio/wav" 
                    class="block w-full text-sm text-slate-300
                    file:mr-4 file:py-3 file:px-6
                    file:rounded-full file:border-0
                    file:text-sm file:font-semibold
                    file:bg-brand-600 file:text-white
                    hover:file:bg-brand-500
                    cursor-pointer bg-slate-800/50 rounded-full border border-slate-700">
            </div>

            <div class="flex items-center gap-4 w-full md:w-auto mt-4 md:mt-0">
                <button id="play-btn" disabled
                    class="flex-1 md:flex-none px-8 py-3 bg-brand-600 hover:bg-brand-500 disabled:bg-slate-700 disabled:text-slate-500 disabled:cursor-not-allowed text-white font-bold rounded-full transition-all shadow-[0_0_15px_rgba(22,163,74,0.3)] hover:shadow-[0_0_25px_rgba(34,197,94,0.5)]">
                    Transcribe & Play
                </button>
            </div>
        </section>

        <!-- Visualizer Section -->
        <section class="glass-panel p-6 rounded-2xl shadow-xl">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold text-slate-200">Audio Analysis</h2>
                <span id="status-indicator" class="text-sm font-mono text-slate-400">WAITING FOR AUDIO</span>
            </div>
            <canvas id="visualizer"></canvas>
        </section>

        <!-- Sheet Music Output Section -->
        <section class="glass-panel p-6 rounded-2xl shadow-xl">
            <h2 class="text-xl font-semibold text-slate-200 mb-4">Generated Sheet Music</h2>
            <div id="sheet-music-container" class="shadow-inner">
                <p id="sheet-placeholder" class="text-slate-500 text-sm italic">Upload and play audio to see transcription here.</p>
                <div id="sheet-content"></div>
            </div>
            
            <div class="mt-4 flex justify-end">
                <button id="export-btn" disabled
                    class="px-6 py-2 bg-slate-700 hover:bg-slate-600 disabled:opacity-50 disabled:cursor-not-allowed text-white text-sm font-medium rounded-lg transition-colors">
                    Export MusicXML (Demo)
                </button>
            </div>
        </section>

    </main>

    <!-- Modal for messages -->
    <div id="message-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 hidden opacity-0 transition-opacity duration-300">
        <div class="glass-panel p-8 rounded-2xl max-w-sm w-full text-center border-slate-700">
            <h3 id="modal-title" class="text-2xl font-bold text-white mb-2">Notice</h3>
            <p id="modal-text" class="text-slate-300 mb-6">Message goes here.</p>
            <button onclick="closeModal()" class="px-6 py-2 bg-brand-600 hover:bg-brand-500 text-white rounded-lg font-medium w-full">Okay</button>
        </div>
    </div>

    <script>
        // UI Elements
        const audioUpload = document.getElementById('audio-upload');
        const playBtn = document.getElementById('play-btn');
        const visualizerCanvas = document.getElementById('visualizer');
        const canvasCtx = visualizerCanvas.getContext('2d');
        const statusIndicator = document.getElementById('status-indicator');
        const sheetContainer = document.getElementById('sheet-music-container');
        const sheetContent = document.getElementById('sheet-content');
        const sheetPlaceholder = document.getElementById('sheet-placeholder');
        const exportBtn = document.getElementById('export-btn');
        
        // Modal Elements
        const modal = document.getElementById('message-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalText = document.getElementById('modal-text');

        // Audio Variables
        let audioContext;
        let audioBuffer;
        let audioSource;
        let analyser;
        let isPlaying = false;
        let animationId;
        let transcriptionInterval;

        // VexFlow variables
        const VF = Vex.Flow;
        let transcribedNotes = [];
        let currentNote = null;
        let currentNoteStartTime = 0;

        audioUpload.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;

            if (!file.type.match('audio.*')) {
                showModal('Error', 'Please upload a valid audio file (MP3 or WAV).');
                this.value = '';
                return;
            }

            statusIndicator.textContent = "LOADING AUDIO...";
            statusIndicator.classList.add('text-yellow-400');
            statusIndicator.classList.remove('text-slate-400');
            playBtn.disabled = true;

            const reader = new FileReader();
            reader.onload = function(ev) {
                const arrayBuffer = ev.target.result;
                initAudioContext(arrayBuffer);
            };
            reader.readAsArrayBuffer(file);
        });

        async function initAudioContext(arrayBuffer) {
            try {
                if (!audioContext) {
                    audioContext = new (window.AudioContext || window.webkitAudioContext)();
                }

                audioBuffer = await audioContext.decodeAudioData(arrayBuffer);
                
                statusIndicator.textContent = "READY TO TRANSCRIBE";
                statusIndicator.classList.replace('text-yellow-400', 'text-brand-500');
                playBtn.disabled = false;
                playBtn.textContent = "Transcribe & Play";
                
                resizeCanvas();
                window.addEventListener('resize', resizeCanvas);
                
                resetTranscription();

            } catch (error) {
                console.error("Error decoding audio:", error);
                showModal('Audio Error', 'Could not decode the audio file.');
                statusIndicator.textContent = "ERROR";
                statusIndicator.classList.replace('text-yellow-400', 'text-red-500');
            }
        }

        function resetTranscription() {
            sheetContent.innerHTML = '';
            sheetPlaceholder.style.display = 'block';
            transcribedNotes = [];
            currentNote = null;
            exportBtn.disabled = true;
        }

        playBtn.addEventListener('click', () => {
            if (isPlaying) {
                stopAudio();
            } else {
                playAndTranscribe();
            }
        });

        function playAndTranscribe() {
            if (!audioBuffer) return;

            if (audioContext.state === 'suspended') {
                audioContext.resume();
            }

            resetTranscription();
            sheetPlaceholder.style.display = 'none';

            audioSource = audioContext.createBufferSource();
            audioSource.buffer = audioBuffer;
            
            analyser = audioContext.createAnalyser();
            analyser.fftSize = 2048; 
            
            audioSource.connect(analyser);
            analyser.connect(audioContext.destination);
            
            audioSource.start(0);
            isPlaying = true;
            
            playBtn.textContent = "Stop Transcription";
            playBtn.classList.replace('bg-brand-600', 'bg-red-600');
            playBtn.classList.replace('hover:bg-brand-500', 'hover:bg-red-500');
            playBtn.classList.replace('shadow-[0_0_15px_rgba(22,163,74,0.3)]', 'shadow-[0_0_15px_rgba(220,38,38,0.3)]');
            
            statusIndicator.textContent = "LISTENING & TRANSCRIBING...";
            statusIndicator.classList.add('pulse-animation');

            audioSource.onended = () => {
                if(isPlaying) stopAudio();
            };

            drawVisualizer();
            
            // Periodically render the accumulated notes
            transcriptionInterval = setInterval(renderTranscribedNotes, 1000);
        }

        function stopAudio() {
            if (audioSource) {
                audioSource.stop();
                audioSource.disconnect();
            }
            isPlaying = false;
            cancelAnimationFrame(animationId);
            clearInterval(transcriptionInterval);
            
            playBtn.textContent = "Transcribe & Play";
            playBtn.classList.replace('bg-red-600', 'bg-brand-600');
            playBtn.classList.replace('hover:bg-red-500', 'hover:bg-brand-500');
            playBtn.classList.replace('shadow-[0_0_15px_rgba(220,38,38,0.3)]', 'shadow-[0_0_15px_rgba(22,163,74,0.3)]');
            
            statusIndicator.textContent = "TRANSCRIBED";
            statusIndicator.classList.remove('pulse-animation');
            
            clearCanvas();
            renderTranscribedNotes(); // Final render
            
            if(transcribedNotes.length > 0) exportBtn.disabled = false;
        }

        // --- REAL PITCH DETECTION LOGIC (Autocorrelation) ---

        // Converts raw frequency to MIDI note number
        function noteFromPitch(frequency) {
            const noteNum = 12 * (Math.log(frequency / 440) / Math.log(2));
            return Math.round(noteNum) + 69;
        }

        // Converts MIDI note number to VexFlow string (e.g. 60 -> "c/4")
        function vexFlowStringFromMidi(midi) {
            const noteStrings = ["c", "c#", "d", "d#", "e", "f", "f#", "g", "g#", "a", "a#", "b"];
            const octave = Math.floor(midi / 12) - 1;
            const noteName = noteStrings[midi % 12];
            return `${noteName}/${octave}`;
        }

        function autoCorrelate(buf, sampleRate) {
            // Find Root Mean Square (volume/energy)
            let rms = 0;
            for (let i = 0; i < buf.length; i++) {
                rms += buf[i] * buf[i];
            }
            rms = Math.sqrt(rms / buf.length);
            
            // Filter out silence or very quiet noise
            if (rms < 0.02) return -1;

            // Find the best fundamental frequency by finding repeating wave patterns
            let r1 = 0, r2 = buf.length - 1, thres = 0.2;
            for (var i = 0; i < buf.length / 2; i++)
                if (Math.abs(buf[i]) < thres) { r1 = i; break; }
            for (var i = 1; i < buf.length / 2; i++)
                if (Math.abs(buf[buf.length - i]) < thres) { r2 = buf.length - i; break; }

            buf = buf.slice(r1, r2);
            let SIZE = buf.length;
            let c = new Array(SIZE).fill(0);
            for (let i = 0; i < SIZE; i++)
                for (let j = 0; j < SIZE - i; j++)
                    c[i] = c[i] + buf[j] * buf[j + i];

            let d = 0; while (c[d] > c[d + 1]) d++;
            let maxval = -1, maxpos = -1;
            for (let i = d; i < SIZE; i++) {
                if (c[i] > maxval) {
                    maxval = c[i];
                    maxpos = i;
                }
            }
            let T0 = maxpos;
            let x1 = c[T0 - 1], x2 = c[T0], x3 = c[T0 + 1];
            let a = (x1 + x3 - 2 * x2) / 2;
            let b = (x3 - x1) / 2;
            if (a) T0 = T0 - b / (2 * a);

            return sampleRate / T0;
        }

        function drawVisualizer() {
            if (!isPlaying) return;
            animationId = requestAnimationFrame(drawVisualizer);

            const bufferLength = analyser.fftSize;
            const dataArray = new Float32Array(bufferLength);
            analyser.getFloatTimeDomainData(dataArray);

            // 1. Detect Pitch from audio frame
            const pitch = autoCorrelate(dataArray, audioContext.sampleRate);
            
            if (pitch !== -1) {
                const midiNote = noteFromPitch(pitch);
                const vexStr = vexFlowStringFromMidi(midiNote);
                
                // Simple Debounce/Filtering: Only record if note is stable
                if (vexStr !== currentNote) {
                    currentNote = vexStr;
                    // Prevent crazy high/low notes from glitching VexFlow (stick to standard piano range)
                    if(midiNote >= 40 && midiNote <= 90) {
                        transcribedNotes.push(vexStr);
                    }
                }
            } else {
                currentNote = null; // Silence
            }

            // 2. Draw visualizer wave
            canvasCtx.fillStyle = 'rgba(2, 6, 23, 0.3)';
            canvasCtx.fillRect(0, 0, visualizerCanvas.width, visualizerCanvas.height);
            canvasCtx.lineWidth = 2;
            canvasCtx.strokeStyle = '#22c55e';
            canvasCtx.beginPath();

            const sliceWidth = visualizerCanvas.width * 1.0 / bufferLength;
            let x = 0;

            for (let i = 0; i < bufferLength; i++) {
                const v = dataArray[i] * 5.0; // Amplify wave visually
                const y = (visualizerCanvas.height / 2) + (v * visualizerCanvas.height / 2);

                if (i === 0) canvasCtx.moveTo(x, y);
                else canvasCtx.lineTo(x, y);

                x += sliceWidth;
            }
            canvasCtx.stroke();
        }

        // --- SHEET MUSIC RENDERING ---

        function renderTranscribedNotes() {
            if (transcribedNotes.length === 0) return;
            
            sheetContent.innerHTML = ''; 
            
            // Limit render to last ~32 notes so it doesn't run off screen infinitely
            const displayNotes = transcribedNotes.slice(-32); 

            const renderer = new VF.Renderer(sheetContent, VF.Renderer.Backends.SVG);
            
            // Dynamic width based on note count
            const width = Math.max(800, displayNotes.length * 35);
            renderer.resize(width, 150);
            const context = renderer.getContext();
            const stave = new VF.Stave(10, 20, width - 20);
            stave.addClef("treble").setContext(context).draw();

            const vfNotes = [];
            
            displayNotes.forEach(noteStr => {
                let note = new VF.StaveNote({ clef: "treble", keys: [noteStr], duration: "q" });
                
                // Add sharp if necessary
                if (noteStr.includes("#")) {
                    note.addModifier(new VF.Accidental("#"));
                }
                vfNotes.push(note);
            });

            if(vfNotes.length > 0) {
                const voice = new VF.Voice({ num_beats: vfNotes.length, beat_value: 4 }).setStrict(false);
                voice.addTickables(vfNotes);
                new VF.Formatter().joinVoices([voice]).format([voice], width - 50);
                voice.draw(context, stave);
                
                // Scroll to end automatically
                sheetContainer.scrollLeft = sheetContainer.scrollWidth;
            }
        }

        exportBtn.addEventListener('click', () => {
            showModal('Success!', 'The real-time pitch detection caught ' + transcribedNotes.length + ' notes. Export feature coming soon!');
        });

        function resizeCanvas() {
            visualizerCanvas.width = visualizerCanvas.parentElement.clientWidth;
        }

        function clearCanvas() {
            canvasCtx.fillStyle = '#020617';
            canvasCtx.fillRect(0, 0, visualizerCanvas.width, visualizerCanvas.height);
            canvasCtx.lineWidth = 2;
            canvasCtx.strokeStyle = '#16a34a';
            canvasCtx.beginPath();
            canvasCtx.moveTo(0, visualizerCanvas.height / 2);
            canvasCtx.lineTo(visualizerCanvas.width, visualizerCanvas.height / 2);
            canvasCtx.stroke();
        }

        function showModal(title, text) {
            modalTitle.textContent = title;
            modalText.textContent = text;
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.classList.add('opacity-100');
            }, 10);
        }

        function closeModal() {
            modal.classList.remove('opacity-100');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300); 
        }

        window.addEventListener('DOMContentLoaded', () => {
            resizeCanvas();
            clearCanvas();
        });

    </script>
</body>
</html>
