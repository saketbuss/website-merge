<!DOCTYPE html>
<html lang="en" class="h-full dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interactive Code Sandbox</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            darkbg: '#0f172a',
            panelbg: '#1e293b',
            bordercolor: '#334155',
            accent: '#38bdf8'
          }
        }
      }
    }
  </script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Ace Editor -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.7/ace.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.7/theme-one_dark.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.7/theme-chrome.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.7/mode-html.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.7/mode-css.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.7/mode-javascript.js"></script>

  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }
    .ace_editor { font-family: 'Fira Code', 'Cascadia Code', 'JetBrains Mono', Consolas, monospace !important; font-size: 14px; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 h-full flex flex-col font-sans overflow-hidden select-none">

  <!-- Top Navigation Header -->
  <header class="bg-slate-900 border-b border-slate-800 px-4 py-2.5 flex items-center justify-between shrink-0">
    <div class="flex items-center space-x-3">
      <div class="bg-sky-500/10 p-2 rounded-lg text-sky-400 border border-sky-500/20">
        <i data-lucide="code-2" class="w-5 h-5"></i>
      </div>
      <div>
        <h1 class="text-sm font-semibold tracking-wide text-slate-100 flex items-center gap-2">
          Code Sandbox Studio
          <span class="text-[10px] bg-sky-500/20 text-sky-300 border border-sky-500/30 px-1.5 py-0.5 rounded font-mono">Live</span>
        </h1>
        <p class="text-xs text-slate-400">Paste code, preview output & debug console</p>
      </div>
    </div>

    <!-- Action Toolbar -->
    <div class="flex items-center space-x-2">
      <!-- Preset Select -->
      <select id="preset-select" class="bg-slate-800 text-xs text-slate-300 border border-slate-700 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-sky-500 cursor-pointer">
        <option value="starter">Template: Web Starter</option>
        <option value="tailwind">Template: Tailwind CSS</option>
        <option value="canvas">Template: HTML5 Canvas</option>
        <option value="empty">Template: Blank Slate</option>
      </select>

      <!-- Auto Run Toggle -->
      <label class="flex items-center space-x-1.5 text-xs text-slate-300 bg-slate-800/80 px-2.5 py-1.5 rounded-lg border border-slate-700/80 cursor-pointer hover:bg-slate-800">
        <input type="checkbox" id="autorun-toggle" checked class="w-3.5 h-3.5 accent-sky-500 rounded cursor-pointer">
        <span>Auto Run</span>
      </label>

      <!-- Run Button -->
      <button id="run-btn" class="flex items-center space-x-1.5 bg-sky-600 hover:bg-sky-500 text-white text-xs font-medium px-3 py-1.5 rounded-lg transition-colors shadow-sm active:scale-95">
        <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i>
        <span>Run Code</span>
      </button>

      <!-- Quick Paste Modal Trigger -->
      <button id="paste-modal-btn" class="flex items-center space-x-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs border border-slate-700 px-3 py-1.5 rounded-lg transition-colors">
        <i data-lucide="clipboard-paste" class="w-3.5 h-3.5"></i>
        <span>Quick Paste</span>
      </button>

      <!-- Download Zip/HTML -->
      <button id="export-btn" class="flex items-center space-x-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs border border-slate-700 px-3 py-1.5 rounded-lg transition-colors" title="Download standalone HTML file">
        <i data-lucide="download" class="w-3.5 h-3.5"></i>
        <span>Export</span>
      </button>
    </div>
  </header>

  <!-- Main Application Workspace with Resizable Split Panels -->
  <main id="main-container" class="flex-1 flex overflow-hidden relative">
    <!-- Mouse Drag Overlay to prevent iframe pointer interference while resizing -->
    <div id="drag-overlay" class="absolute inset-0 z-50 hidden pointer-events-auto"></div>
    
    <!-- Left Column: Code Editor Side -->
    <div id="left-panel" class="w-1/2 flex flex-col border-r border-slate-800 bg-slate-900 min-w-[200px]">
      <!-- File Tabs Header -->
      <div class="flex items-center justify-between bg-slate-950/60 border-b border-slate-800 px-2">
        <div class="flex space-x-1" id="tab-container">
          <button data-tab="html" class="tab-btn active flex items-center space-x-2 px-3 py-2 text-xs font-medium border-b-2 border-sky-400 text-sky-400 bg-slate-900/80 transition-all">
            <i data-lucide="file-code" class="w-3.5 h-3.5 text-orange-400"></i>
            <span>index.html</span>
          </button>
          <button data-tab="css" class="tab-btn flex items-center space-x-2 px-3 py-2 text-xs font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-all">
            <i data-lucide="file-type-2" class="w-3.5 h-3.5 text-blue-400"></i>
            <span>styles.css</span>
          </button>
          <button data-tab="js" class="tab-btn flex items-center space-x-2 px-3 py-2 text-xs font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-all">
            <i data-lucide="file-json" class="w-3.5 h-3.5 text-yellow-400"></i>
            <span>script.js</span>
          </button>
        </div>

        <div class="flex items-center space-x-2 pr-2">
          <button id="format-btn" class="p-1 text-slate-400 hover:text-slate-200 rounded hover:bg-slate-800" title="Format Code">
            <i data-lucide="wand-2" class="w-3.5 h-3.5"></i>
          </button>
          <button id="copy-btn" class="p-1 text-slate-400 hover:text-slate-200 rounded hover:bg-slate-800" title="Copy Current Editor Code">
            <i data-lucide="copy" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      </div>

      <!-- Editor Container (3 Ace Editor instances stacked) -->
      <div class="flex-1 relative overflow-hidden">
        <div id="editor-html" class="absolute inset-0"></div>
        <div id="editor-css" class="absolute inset-0 hidden"></div>
        <div id="editor-js" class="absolute inset-0 hidden"></div>
      </div>

      <!-- Editor Footer Info -->
      <div class="bg-slate-950 border-t border-slate-800 px-3 py-1 flex justify-between items-center text-[11px] text-slate-500 font-mono">
        <div id="cursor-pos">Ln 1, Col 1</div>
        <div id="doc-size">0 chars</div>
      </div>
    </div>

    <!-- Horizontal Drag Resizer Handle -->
    <div id="h-resizer" class="w-1.5 bg-slate-800 hover:bg-sky-500/60 active:bg-sky-500 cursor-col-resize transition-colors flex items-center justify-center shrink-0 z-20 group">
      <div class="w-0.5 h-8 bg-slate-600 group-hover:bg-slate-200 rounded-full transition-colors"></div>
    </div>

    <!-- Right Column: Live Preview & Console Output -->
    <div id="right-panel" class="w-1/2 flex flex-col bg-slate-950 min-w-[200px]">
      
      <!-- Top Half: Preview Iframe -->
      <div id="preview-panel" class="h-2/3 flex flex-col relative min-h-[120px]">
        <!-- Preview Header -->
        <div class="bg-slate-900 border-b border-slate-800 px-3 py-1.5 flex items-center justify-between text-xs text-slate-400">
          <div class="flex items-center space-x-2">
            <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
            <span class="font-medium text-slate-300">Live Render Window</span>
          </div>
          <div class="flex items-center space-x-2">
            <button id="reload-preview-btn" class="p-1 hover:text-slate-200 transition-colors" title="Refresh Preview">
              <i data-lucide="rotate-cw" class="w-3.5 h-3.5"></i>
            </button>
            <button id="open-new-window-btn" class="p-1 hover:text-slate-200 transition-colors" title="Open preview in new tab">
              <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
            </button>
          </div>
        </div>

        <!-- Render Target Iframe -->
        <iframe id="preview-iframe" class="w-full flex-1 bg-white border-none" sandbox="allow-scripts allow-modals allow-same-origin"></iframe>
      </div>

      <!-- Vertical Drag Resizer Handle -->
      <div id="v-resizer" class="h-1.5 bg-slate-800 hover:bg-sky-500/60 active:bg-sky-500 cursor-row-resize transition-colors flex items-center justify-center shrink-0 z-20 group">
        <div class="h-0.5 w-8 bg-slate-600 group-hover:bg-slate-200 rounded-full transition-colors"></div>
      </div>

      <!-- Bottom Half: Console Terminal Output -->
      <div id="console-panel" class="h-1/3 flex flex-col bg-slate-950 min-h-[80px]">
        <div class="bg-slate-900 px-3 py-1.5 border-b border-slate-800 flex items-center justify-between text-xs">
          <div class="flex items-center space-x-2 text-slate-300 font-medium">
            <i data-lucide="terminal" class="w-3.5 h-3.5 text-sky-400"></i>
            <span>Console Log</span>
            <span id="log-count" class="bg-slate-800 text-slate-400 text-[10px] px-1.5 py-0.5 rounded-full border border-slate-700">0</span>
          </div>
          <button id="clear-console-btn" class="text-slate-400 hover:text-slate-200 flex items-center space-x-1 text-[11px] px-2 py-0.5 rounded hover:bg-slate-800">
            <i data-lucide="trash-2" class="w-3 h-3"></i>
            <span>Clear</span>
          </button>
        </div>

        <!-- Console Log List -->
        <div id="console-output" class="flex-1 p-2 font-mono text-xs overflow-y-auto space-y-1.5 text-slate-300 select-text">
          <div class="text-slate-600 italic">Console output will appear here...</div>
        </div>
      </div>

    </div>
  </main>

  <!-- Quick Paste Modal -->
  <div id="paste-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden">
    <div class="bg-slate-900 border border-slate-800 rounded-xl shadow-2xl w-full max-w-2xl p-5 flex flex-col space-y-4">
      <div class="flex justify-between items-center">
        <h3 class="text-base font-semibold text-slate-100 flex items-center gap-2">
          <i data-lucide="clipboard" class="w-4 h-4 text-sky-400"></i>
          Quick Code Ingestion
        </h3>
        <button id="close-modal-btn" class="text-slate-400 hover:text-slate-200">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      
      <p class="text-xs text-slate-400">
        Paste any standard HTML block, full HTML document, or code snippet below. It will be automatically assigned to the HTML editor.
      </p>

      <textarea id="modal-paste-area" class="w-full h-48 bg-slate-950 border border-slate-800 rounded-lg p-3 text-xs font-mono text-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500 resize-none" placeholder="Paste HTML / JS / CSS code block here..."></textarea>

      <div class="flex justify-end space-x-2">
        <button id="cancel-modal-btn" class="px-3 py-1.5 rounded-lg border border-slate-700 text-xs text-slate-300 hover:bg-slate-800">Cancel</button>
        <button id="apply-paste-btn" class="px-4 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-xs font-medium text-white shadow">Apply Code</button>
      </div>
    </div>
  </div>

  <!-- Notification Toast -->
  <div id="toast" class="fixed bottom-4 right-4 bg-slate-800 text-slate-200 border border-slate-700 px-3 py-2 rounded-lg text-xs shadow-lg flex items-center space-x-2 transition-all opacity-0 pointer-events-none transform translate-y-2 z-50">
    <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
    <span id="toast-msg">Notification</span>
  </div>

  <script>
    // Initialize Lucide icons
    lucide.createIcons();

    // Default Code Templates
    const TEMPLATES = {
      starter: {
        html: `<div class="card">\n  <h1>Hello Sandbox! 👋</h1>\n  <p>Paste your HTML code here or start building right away.</p>\n  <button id="demo-btn">Click Me!</button>\n</div>`,
        css: `body {\n  font-family: system-ui, -apple-system, sans-serif;\n  background: #f8fafc;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 100vh;\n  margin: 0;\n}\n\n.card {\n  background: white;\n  padding: 2rem;\n  border-radius: 12px;\n  box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);\n  text-align: center;\n  max-width: 400px;\n}\n\nh1 {\n  color: #0f172a;\n  margin-top: 0;\n}\n\np {\n  color: #64748b;\n}\n\nbutton {\n  background: #0284c7;\n  color: white;\n  border: none;\n  padding: 10px 20px;\n  border-radius: 6px;\n  cursor: pointer;\n  font-weight: 600;\n  transition: background 0.2s;\n}\n\nbutton:hover {\n  background: #0369a1;\n}`,
        js: `console.log("Welcome to Code Sandbox!");\n\nconst btn = document.getElementById("demo-btn");\nbtn.addEventListener("click", () => {\n  console.log("Button clicked at:", new Date().toLocaleTimeString());\n  btn.innerText = "Awesome!";\n});`
      },
      tailwind: {
        html: `<div class="min-h-screen bg-slate-900 text-white flex items-center justify-center p-6">\n  <div class="bg-slate-800 border border-slate-700 rounded-2xl p-8 max-w-sm w-full text-center shadow-2xl space-y-4">\n    <div class="w-12 h-12 bg-sky-500/20 text-sky-400 rounded-xl flex items-center justify-center mx-auto text-2xl">🚀</div>\n    <h2 class="text-xl font-bold tracking-tight">Tailwind Sandbox</h2>\n    <p class="text-sm text-slate-400">Tailwind CSS CDN is preloaded and ready for rapid UI prototyping.</p>\n    <button id="tw-btn" class="w-full bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold py-2 px-4 rounded-lg transition-all active:scale-95">\n      Interactive Button\n    </button>\n  </div>\n</div>`,
        css: `/* Custom CSS overrides can go here */`,
        js: `document.getElementById('tw-btn').addEventListener('click', () => {\n  console.log('Tailwind component clicked!');\n});`
      },
      canvas: {
        html: `<canvas id="artCanvas"></canvas>`,
        css: `body, html {\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: #000;\n}\ncanvas {\n  display: block;\n}`,
        js: `const canvas = document.getElementById('artCanvas');\nconst ctx = canvas.getContext('2d');\ncanvas.width = window.innerWidth;\ncanvas.height = window.innerHeight;\n\nlet particles = [];\nfor(let i=0; i<60; i++) {\n  particles.push({\n    x: Math.random() * canvas.width,\n    y: Math.random() * canvas.height,\n    r: Math.random() * 4 + 1,\n    dx: (Math.random() - 0.5) * 2,\n    dy: (Math.random() - 0.5) * 2,\n    color: \`hsl(\${Math.random() * 360}, 70%, 60%)\` \n  });\n}\n\nfunction animate() {\n  requestAnimationFrame(animate);\n  ctx.fillStyle = 'rgba(0, 0, 0, 0.1)';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  \n  particles.forEach(p => {\n    p.x += p.dx;\n    p.y += p.dy;\n    if(p.x < 0 || p.x > canvas.width) p.dx *= -1;\n    if(p.y < 0 || p.y > canvas.height) p.dy *= -1;\n    \n    ctx.beginPath();\n    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);\n    ctx.fillStyle = p.color;\n    ctx.fill();\n  });\n}\n\nconsole.log("Canvas Animation Started");\nanimate();`
      },
      empty: { html: '', css: '', js: '' }
    };

    // State Variables
    let activeTab = 'html';
    let editors = {};
    let debounceTimer = null;
    let logCount = 0;

    function initEditors() {
      const tabNames = ['html', 'css', 'js'];
      const modes = { html: 'ace/mode/html', css: 'ace/mode/css', js: 'ace/mode/javascript' };

      tabNames.forEach(tab => {
        const ed = ace.edit(`editor-${tab}`);
        ed.setTheme('ace/theme/one_dark');
        ed.session.setMode(modes[tab]);
        ed.setShowPrintMargin(false);
        ed.setOptions({
          enableBasicAutocompletion: true,
          enableLiveAutocompletion: true,
          fontFamily: 'Fira Code, monospace',
          fontSize: '13px'
        });

        // Set initial content
        ed.setValue(TEMPLATES.starter[tab], -1);

        // Change Listener
        ed.session.on('change', () => {
          updateFooterInfo();
          if (document.getElementById('autorun-toggle').checked) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(runCode, 600);
          }
        });

        ed.selection.on('changeCursor', updateFooterInfo);

        editors[tab] = ed;
      });

      updateFooterInfo();
      runCode();
    }

    // Update Footer Status Bar
    function updateFooterInfo() {
      const currentEditor = editors[activeTab];
      if (!currentEditor) return;
      const pos = currentEditor.getCursorPosition();
      const code = currentEditor.getValue();
      document.getElementById('cursor-pos').innerText = `Ln ${pos.row + 1}, Col ${pos.column + 1}`;
      document.getElementById('doc-size').innerText = `${code.length} chars`;
    }

    // Switch Editor Tabs
    function switchTab(tabName) {
      activeTab = tabName;
      document.querySelectorAll('#tab-container button').forEach(btn => {
        const isCurrent = btn.dataset.tab === tabName;
        btn.classList.toggle('border-sky-400', isCurrent);
        btn.classList.toggle('text-sky-400', isCurrent);
        btn.classList.toggle('bg-slate-900/80', isCurrent);
        btn.classList.toggle('border-transparent', !isCurrent);
        btn.classList.toggle('text-slate-400', !isCurrent);
      });

      ['html', 'css', 'js'].forEach(t => {
        const container = document.getElementById(`editor-${t}`);
        if (t === tabName) {
          container.classList.remove('hidden');
          editors[t].focus();
        } else {
          container.classList.add('hidden');
        }
      });

      updateFooterInfo();
    }

    function runCode() {
      const htmlVal = editors.html.getValue();
      const cssVal = editors.css.getValue();
      const jsVal = editors.js.getValue();

      const consoleScript = `
        <script>
          (function() {
            function sendLog(type, args) {
              window.parent.postMessage({
                type: 'CONSOLE_LOG',
                logType: type,
                data: Array.from(args).map(arg => {
                  try {
                    return typeof arg === 'object' ? JSON.stringify(arg) : String(arg);
                  } catch(e) { return String(arg); }
                }).join(' ')
              }, '*');
            }
            const origLog = console.log;
            const origErr = console.error;
            const origWarn = console.warn;
            
            console.log = function(...args) { origLog.apply(console, args); sendLog('log', args); };
            console.error = function(...args) { origErr.apply(console, args); sendLog('error', args); };
            console.warn = function(...args) { origWarn.apply(console, args); sendLog('warn', args); };

            window.onerror = function(msg, url, line) {
              sendLog('error', ['Error: ' + msg + ' (Line ' + line + ')']);
              return false;
            };
          })();
        <\/script>
      `;

      const combinesDoc = `
        <!DOCTYPE html>
        <html>
        <head>
          <meta charset="UTF-8">
          <script src="https://cdn.tailwindcss.com"><\/script>
          <style>${cssVal}</style>
          ${consoleScript}
        </head>
        <body>
          ${htmlVal}
          <script>
            try {
              ${jsVal}
            } catch(err) {
              console.error(err.message);
            }
          <\/script>
        </body>
        </html>
      `;

      const iframe = document.getElementById('preview-iframe');
      iframe.srcdoc = combinesDoc;
    }

    // Add Console Entry
    function appendConsoleLog(type, text) {
      const consoleOutput = document.getElementById('console-output');
      if (logCount === 0) {
        consoleOutput.innerHTML = '';
      }
      logCount++;
      document.getElementById('log-count').innerText = logCount;

      const entry = document.createElement('div');
      entry.className = 'flex items-start space-x-2 border-b border-slate-900/50 pb-1 font-mono text-[12px]';
      
      let badgeClass = 'text-sky-400';
      let icon = 'info';
      if (type === 'error') { badgeClass = 'text-rose-400 bg-rose-500/10 p-0.5 rounded'; icon = 'alert-circle'; }
      if (type === 'warn') { badgeClass = 'text-amber-400 bg-amber-500/10 p-0.5 rounded'; icon = 'alert-triangle'; }

      entry.innerHTML = `
        <span class="${badgeClass} shrink-0 mt-0.5">[${type.toUpperCase()}]</span>
        <span class="text-slate-200 break-all">${escapeHtml(text)}</span>
      `;
      
      consoleOutput.appendChild(entry);
      consoleOutput.scrollTop = consoleOutput.scrollHeight;
    }

    function escapeHtml(str) {
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    // Notification Toast Helper
    function showToast(message) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-msg').innerText = message;
      toast.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
      }, 2500);
    }

    // Listen to iframe console messages
    window.addEventListener('message', (e) => {
      if (e.data && e.data.type === 'CONSOLE_LOG') {
        appendConsoleLog(e.data.logType, e.data.data);
      }
    });

    // Tab Buttons Listener
    document.getElementById('tab-container').addEventListener('click', (e) => {
      const btn = e.target.closest('button');
      if (btn && btn.dataset.tab) {
        switchTab(btn.dataset.tab);
      }
    });

    // Template Dropdown
    document.getElementById('preset-select').addEventListener('change', (e) => {
      const val = e.target.value;
      if (TEMPLATES[val]) {
        editors.html.setValue(TEMPLATES[val].html, -1);
        editors.css.setValue(TEMPLATES[val].css, -1);
        editors.js.setValue(TEMPLATES[val].js, -1);
        document.getElementById('console-output').innerHTML = '<div class="text-slate-600 italic">Console output will appear here...</div>';
        logCount = 0;
        document.getElementById('log-count').innerText = '0';
        runCode();
        showToast(`Loaded ${e.target.options[e.target.selectedIndex].text}`);
      }
    });

    // Run Button
    document.getElementById('run-btn').addEventListener('click', () => {
      runCode();
      showToast('Code executed');
    });

    // Reload Preview Button
    document.getElementById('reload-preview-btn').addEventListener('click', () => {
      runCode();
      showToast('Preview refreshed');
    });

    // Clear Console
    document.getElementById('clear-console-btn').addEventListener('click', () => {
      document.getElementById('console-output').innerHTML = '<div class="text-slate-600 italic">Console cleared</div>';
      logCount = 0;
      document.getElementById('log-count').innerText = '0';
    });

    // Copy Current Tab
    document.getElementById('copy-btn').addEventListener('click', () => {
      const code = editors[activeTab].getValue();
      navigator.clipboard.writeText(code).then(() => {
        showToast(`Copied ${activeTab.toUpperCase()} code to clipboard`);
      });
    });

    // Quick Paste Modal Handlers
    const modal = document.getElementById('paste-modal');
    document.getElementById('paste-modal-btn').addEventListener('click', () => modal.classList.remove('hidden'));
    document.getElementById('close-modal-btn').addEventListener('click', () => modal.classList.add('hidden'));
    document.getElementById('cancel-modal-btn').addEventListener('click', () => modal.classList.add('hidden'));

    document.getElementById('apply-paste-btn').addEventListener('click', () => {
      const pastedVal = document.getElementById('modal-paste-area').value;
      if (pastedVal.trim()) {
        editors.html.setValue(pastedVal, -1);
        switchTab('html');
        runCode();
        showToast('Pasted code inserted into HTML!');
      }
      modal.classList.add('hidden');
      document.getElementById('modal-paste-area').value = '';
    });

    // Export HTML File
    document.getElementById('export-btn').addEventListener('click', () => {
      const fullDoc = `<!DOCTYPE html>\n<html>\n<head>\n  <meta charset="UTF-8">\n  <title>Exported Sandbox</title>\n  <script src="https://cdn.tailwindcss.com"><\/script>\n  <style>\n${editors.css.getValue()}\n  </style>\n</head>\n<body>\n${editors.html.getValue()}\n  <script>\n${editors.js.getValue()}\n  <\/script>\n</body>\n</html>`;
      const blob = new Blob([fullDoc], { type: 'text/html' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'sandbox-export.html';
      a.click();
      showToast('Downloaded index.html export!');
    });

    // Open In New Window (Optimized Blob URL with smooth about:blank fallback)
    let externalPreviewBlobUrl = null;

    document.getElementById('open-new-window-btn').addEventListener('click', () => {
      const fullDoc = `<!DOCTYPE html>\n<html>\n<head>\n  <meta charset="UTF-8">\n  <title>Live Preview</title>\n  <script src="https://cdn.tailwindcss.com"><\/script>\n  <style>${editors.css.getValue()}</style>\n</head>\n<body>\n${editors.html.getValue()}\n  <script>${editors.js.getValue()}<\/script>\n</body>\n</html>`;
      
      try {
        if (externalPreviewBlobUrl) {
          URL.revokeObjectURL(externalPreviewBlobUrl);
        }
        const blob = new Blob([fullDoc], { type: 'text/html;charset=utf-8' });
        externalPreviewBlobUrl = URL.createObjectURL(blob);
        const win = window.open(externalPreviewBlobUrl, '_blank');
        if (!win) {
          showToast('Popup blocked! Please allow popups.');
        } else {
          showToast('Opened preview in new tab!');
        }
      } catch(e) {
        // Fallback for tight security contexts using document open/write cycle on about:blank
        const win = window.open('about:blank', '_blank');
        if (win) {
          win.document.open();
          win.document.write(fullDoc);
          win.document.close();
          showToast('Opened preview tab!');
        }
      }
    });

    // Interactive Resizers Initialization
    function initResizers() {
      const hResizer = document.getElementById('h-resizer');
      const vResizer = document.getElementById('v-resizer');
      const leftPanel = document.getElementById('left-panel');
      const rightPanel = document.getElementById('right-panel');
      const previewPanel = document.getElementById('preview-panel');
      const consolePanel = document.getElementById('console-panel');
      const container = document.getElementById('main-container');
      const overlay = document.getElementById('drag-overlay');

      let isDraggingH = false;
      let isDraggingV = false;

      // Horizontal Resize Mouse Down
      hResizer.addEventListener('mousedown', (e) => {
        isDraggingH = true;
        overlay.classList.remove('hidden');
        overlay.style.cursor = 'col-resize';
        document.body.classList.add('select-none');
      });

      // Vertical Resize Mouse Down
      vResizer.addEventListener('mousedown', (e) => {
        isDraggingV = true;
        overlay.classList.remove('hidden');
        overlay.style.cursor = 'row-resize';
        document.body.classList.add('select-none');
      });

      // Drag Move Handler
      window.addEventListener('mousemove', (e) => {
        if (isDraggingH) {
          const rect = container.getBoundingClientRect();
          let offsetX = e.clientX - rect.left;
          let percent = (offsetX / rect.width) * 100;
          percent = Math.max(15, Math.min(85, percent));
          leftPanel.style.width = `${percent}%`;
          rightPanel.style.width = `${100 - percent}%`;
          if (editors[activeTab]) editors[activeTab].resize();
        }

        if (isDraggingV) {
          const rect = rightPanel.getBoundingClientRect();
          let offsetY = e.clientY - rect.top;
          let percent = (offsetY / rect.height) * 100;
          percent = Math.max(15, Math.min(85, percent));
          previewPanel.style.height = `${percent}%`;
          consolePanel.style.height = `${100 - percent}%`;
        }
      });

      // Drag End Handler
      window.addEventListener('mouseup', () => {
        if (isDraggingH || isDraggingV) {
          isDraggingH = false;
          isDraggingV = false;
          overlay.classList.add('hidden');
          document.body.classList.remove('select-none');
          if (editors[activeTab]) editors[activeTab].resize();
        }
      });

      // Handle window resize event
      window.addEventListener('resize', () => {
        if (editors[activeTab]) editors[activeTab].resize();
      });
    }

    // Initialize Application
    window.addEventListener('DOMContentLoaded', () => {
      initEditors();
      initResizers();
    });
  </script>
</body>
</html>
