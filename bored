                div.innerHTML = `
                    <div class="flex items-center gap-3 overflow-hidden pr-2">
                        <span class="px-2.5 py-1 rounded-xl font-bold border ${badgeClass} shrink-0 flex items-center gap-1.5">
                            <i class="fa-solid ${icon}"></i>
                            ${item.type}
                        </span>
                        <div class="truncate">
                            <span class="font-bold text-slate-200">${item.title}</span>
                            <p class="text-slate-400 truncate text-[11px]">${item.detail}</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <span class="text-[10px] text-slate-500">${item.time}</span>
                        ${item.actionUrl ? `<a href="${item.actionUrl}" target="_blank" class="p-1.5 text-slate-400 hover:text-white transition"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>` : ''}
                    </div>
                `;
                historyList.appendChild(div);
            });
        }

        function clearHistory() {
            history = [];
            renderHistory();
            showToast("History log cleared!");
        }

        function launchRandomWebsite() {
            playSound('click');
            incrementClicks();

            const randomSite = coolWebsites[Math.floor(Math.random() * coolWebsites.length)];

            document.getElementById('webCategoryTag').innerText = randomSite.category;
            document.getElementById('webModalTitle').innerText = randomSite.name;
            document.getElementById('webModalDesc').innerText = randomSite.desc;
            document.getElementById('webModalUrl').innerText = randomSite.url;
            document.getElementById('webModalLaunchBtn').href = randomSite.url;

            const modal = document.getElementById('websiteModal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100', 'pointer-events-auto');

            logHistory('Random Web', randomSite.name, randomSite.desc, randomSite.url);
        }

        function closeWebsiteModal() {
            const modal = document.getElementById('websiteModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.remove('opacity-100', 'pointer-events-auto');
        }

        function launchRandomStreetView() {
            playSound('teleport');
            incrementClicks();

            const location = streetViewLocations[Math.floor(Math.random() * streetViewLocations.length)];

            document.getElementById('modalLocTitle').innerText = `${location.title} (${location.country})`;
            document.getElementById('modalLocCoords').innerText = `Coordinates: ${location.lat.toFixed(4)}, ${location.lng.toFixed(4)}`;
            document.getElementById('modalLocDescription').innerText = location.desc;

            const embedUrl = `https://maps.google.com/maps?q=&layer=c&cbll=${location.lat},${location.lng}&cbp=11,0,0,0,0&output=svembed`;
            const directUrl = `https://www.google.com/maps/@?api=1&map_action=pano&viewpoint=${location.lat},${location.lng}`;

            document.getElementById('streetViewIframe').src = embedUrl;
            document.getElementById('modalDirectLink').href = directUrl;

            const modal = document.getElementById('streetViewModal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100', 'pointer-events-auto');

            logHistory('Street View', location.title, location.country, directUrl);
        }

        function toggleStreetViewFullscreen() {
            const card = document.getElementById('streetViewCard');
            const icon = document.getElementById('fsIcon');
            card.classList.toggle('modal-fullscreen');
            if (card.classList.contains('modal-fullscreen')) {
                icon.className = "fa-solid fa-compress";
                showToast("Expanded Street View mode!");
            } else {
                icon.className = "fa-solid fa-expand";
            }
        }

        function closeStreetViewModal() {
            const modal = document.getElementById('streetViewModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.remove('opacity-100', 'pointer-events-auto');
            document.getElementById('streetViewIframe').src = '';
        }

        function generateGoofySentence() {
            playSound('goofy');
            incrementClicks();

            const sub = subjects[Math.floor(Math.random() * subjects.length)];
            const vrb = verbs[Math.floor(Math.random() * verbs.length)];
            const obj = objects[Math.floor(Math.random() * objects.length)];
            const loc = locations[Math.floor(Math.random() * locations.length)];
            const sentence = `${sub} ${vrb} ${obj} ${loc}`;

            currentTextOutput = sentence;
            showTextBanner("Freshly Baked Goofiness", `"${sentence}"`, "bg-emerald-500", "text-emerald-400");
            logHistory('Goofy Sentence', 'Random Goof', sentence);
        }

        function generateWeirdFact() {
            playSound('magic');
            incrementClicks();

            const fact = weirdFacts[Math.floor(Math.random() * weirdFacts.length)];
            currentTextOutput = fact;
            showTextBanner("Mind-Blowing Real Fact", `"${fact}"`, "bg-amber-500", "text-amber-400");
            logHistory('Weird Fact', 'Mind Reader Fact', fact);
        }

        function generateRandomJoke() {
            playSound('joke');
            incrementClicks();

            const joke = randomJokes[Math.floor(Math.random() * randomJokes.length)];
            currentTextOutput = joke;
            showTextBanner("Hilarious Joke / Pun", `"${joke}"`, "bg-rose-500", "text-rose-400");
            logHistory('Joke & Pun', 'Random Joke', joke);
        }

        function showTextBanner(badgeText, mainText, barColor, textColor) {
            const container = document.getElementById('textOutputContainer');
            document.getElementById('outputBadge').innerHTML = `<i class="fa-solid fa-quote-left"></i><span>${badgeText}</span>`;
            document.getElementById('outputBadge').className = `flex items-center gap-2 text-xs font-bold uppercase tracking-wider ${textColor}`;
            document.getElementById('outputAccentBar').className = `absolute top-0 left-0 w-2 h-full ${barColor}`;
            document.getElementById('textOutput').innerText = mainText;

            container.classList.remove('hidden');
            container.classList.remove('speech-bubble');
            void container.offsetWidth; 
            container.classList.add('speech-bubble');
        }

        function speakText() {
            if (!currentTextOutput) return;
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(currentTextOutput);
                utterance.pitch = 1.2;
                utterance.rate = 1.0;
                window.speechSynthesis.speak(utterance);
                showToast("Reading aloud! 🗣️");
            } else {
                showToast("Speech synthesis not supported in this browser.");
            }
        }

        function copyText() {
            if (!currentTextOutput) return;
            const tempInput = document.createElement("textarea");
            tempInput.value = currentTextOutput;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);
            showToast("Copied text to clipboard! 📋");
        }

        function openAkinatorModal() {
            playSound('magic');
            incrementClicks();

            document.getElementById('akiIntroScreen').classList.remove('hidden');
            document.getElementById('akiQuestionScreen').classList.add('hidden');
            document.getElementById('akiRevealScreen').classList.add('hidden');

            const modal = document.getElementById('akinatorModal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100', 'pointer-events-auto');
        }

        function closeAkinatorModal() {
            const modal = document.getElementById('akinatorModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.remove('opacity-100', 'pointer-events-auto');
        }

        function startAkinatorGame() {
            playSound('click');
            akiCurrentQIndex = 0;
            akiCandidates = [...akinatorCharacters];

            document.getElementById('akiIntroScreen').classList.add('hidden');
            document.getElementById('akiQuestionScreen').classList.remove('hidden');

            renderAkinatorQuestion();
        }

        function renderAkinatorQuestion() {
            const q = akiQuestions[akiCurrentQIndex];
            document.getElementById('akiQNum').innerText = `Question #${akiCurrentQIndex + 1}`;
            document.getElementById('akiQuestionText').innerText = `"${q.text}"`;
            
            const progress = Math.round(((akiCurrentQIndex + 1) / akiQuestions.length) * 100);
            document.getElementById('akiProgressBar').style.width = `${progress}%`;
            document.getElementById('akiConfidence').innerText = `Confidence: ${20 + akiCurrentQIndex * 18}%`;
        }

        function answerAkinator(ans) {
            playSound('click');
            const currentQ = akiQuestions[akiCurrentQIndex];

            if (ans === 'yes' || ans === 'probably') {
                akiCandidates = akiCandidates.filter(c => c[currentQ.key] === true);
            } else if (ans === 'no') {
                akiCandidates = akiCandidates.filter(c => c[currentQ.key] === false);
            }

            akiCurrentQIndex++;

            if (akiCurrentQIndex >= akiQuestions.length || akiCandidates.length <= 1) {
                revealAkinatorGuess();
            } else {
                renderAkinatorQuestion();
            }
        }

        function revealAkinatorGuess() {
            playSound('magic');
            const winner = akiCandidates.length > 0 ? akiCandidates[0] : akinatorCharacters[0];

            document.getElementById('akiQuestionScreen').classList.add('hidden');
            document.getElementById('akiRevealScreen').classList.remove('hidden');

            document.getElementById('akiGuessName').innerText = winner.name;
            document.getElementById('akiGuessDesc').innerText = winner.desc;
            document.getElementById('akiRevealEmoji').innerText = winner.emoji;

            logHistory('Akinator', 'Mind Read Guess', winner.name);
        }

        function restartAkinator() {
            startAkinatorGame();
        }

        function triggerWildcard() {
            const choices = [1, 2, 3, 4, 5, 6];
            const rand = choices[Math.floor(Math.random() * choices.length)];

            if (rand === 1) launchRandomWebsite();
            else if (rand === 2) launchRandomStreetView();
            else if (rand === 3) generateGoofySentence();
            else if (rand === 4) openAkinatorModal();
            else if (rand === 5) generateWeirdFact();
            else generateRandomJoke();
        }

        window.onclick = function(event) {
            if (event.target === document.getElementById('streetViewModal')) closeStreetViewModal();
            if (event.target === document.getElementById('websiteModal')) closeWebsiteModal();
            if (event.target === document.getElementById('akinatorModal')) closeAkinatorModal();
        };
    </script>
</body>
</html>
