<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Ultimate Portal of Randomness</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background: #090d16;
            color: #f8fafc;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .font-fun {
            font-family: 'Fredoka', cursive;
        }

        /* Glassmorphism Card Style */
        .glass-card {
            background: rgba(22, 30, 49, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
        }

        /* Animated Glowing Buttons */
        .glow-btn-1 {
            background: linear-gradient(135deg, #ec4899, #8b5cf6);
            box-shadow: 0 0 20px rgba(236, 72, 153, 0.4);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glow-btn-1:hover {
            box-shadow: 0 0 30px rgba(236, 72, 153, 0.8);
            transform: translateY(-3px) scale(1.02);
        }

        .glow-btn-2 {
            background: linear-gradient(135deg, #06b6d4, #3b82f6);
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.4);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glow-btn-2:hover {
            box-shadow: 0 0 30px rgba(6, 182, 212, 0.8);
            transform: translateY(-3px) scale(1.02);
        }

        .glow-btn-3 {
            background: linear-gradient(135deg, #10b981, #f59e0b);
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.4);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glow-btn-3:hover {
            box-shadow: 0 0 30px rgba(16, 185, 129, 0.8);
            transform: translateY(-3px) scale(1.02);
        }

        .glow-btn-4 {
            background: linear-gradient(135deg, #a855f7, #ec4899);
            box-shadow: 0 0 20px rgba(168, 85, 247, 0.4);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glow-btn-4:hover {
            box-shadow: 0 0 30px rgba(168, 85, 247, 0.8);
            transform: translateY(-3px) scale(1.02);
        }

        .glow-btn-5 {
            background: linear-gradient(135deg, #f59e0b, #ef4444);
            box-shadow: 0 0 20px rgba(245, 158, 11, 0.4);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glow-btn-5:hover {
            box-shadow: 0 0 30px rgba(245, 158, 11, 0.8);
            transform: translateY(-3px) scale(1.02);
        }

        .glow-btn-6 {
            background: linear-gradient(135deg, #f43f5e, #eab308);
            box-shadow: 0 0 20px rgba(244, 63, 94, 0.4);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glow-btn-6:hover {
            box-shadow: 0 0 30px rgba(244, 63, 94, 0.8);
            transform: translateY(-3px) scale(1.02);
        }

        .glow-wildcard {
            background: linear-gradient(135deg, #ff007f, #7928ca, #4299e1);
            background-size: 200% 200%;
            animation: gradientShift 4s ease infinite;
        }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Floating background elements */
        .floating-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }

        .blob {
            position: absolute;
            filter: blur(90px);
            opacity: 0.2;
            border-radius: 50%;
            animation: float 22s infinite ease-in-out;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(40px, -60px) scale(1.15); }
            66% { transform: translate(-30px, 30px) scale(0.85); }
        }

        /* Speech bubble pop */
        .speech-bubble {
            animation: popIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes popIn {
            0% { transform: scale(0.9) translateY(12px); opacity: 0; }
            100% { transform: scale(1) translateY(0); opacity: 1; }
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090d16;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #334155;
        }

        /* Modal Fullscreen Utility */
        .modal-fullscreen {
            max-width: 98vw !important;
            height: 94vh !important;
        }
    </style>
</head>
<body class="relative flex flex-col justify-between min-h-screen">

    <div class="floating-bg">
        <div class="blob bg-pink-500 w-96 h-96 -top-10 -left-10"></div>
        <div class="blob bg-cyan-500 w-96 h-96 top-1/2 -right-10"></div>
        <div class="blob bg-amber-500 w-80 h-80 -bottom-10 left-1/3"></div>
        <div class="blob bg-purple-600 w-96 h-96 top-1/4 left-1/2"></div>
    </div>

    <header class="relative z-10 w-full max-w-7xl mx-auto px-4 py-6 flex flex-wrap justify-between items-center gap-4">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-pink-500 via-purple-500 to-indigo-500 flex items-center justify-center text-white text-2xl shadow-lg transform -rotate-6">
                <i class="fa-solid fa-dice-d20 animate-spin" style="animation-duration: 12s;"></i>
            </div>
            <div>
                <h1 class="text-2xl sm:text-3xl font-extrabold font-fun tracking-wide bg-clip-text text-transparent bg-gradient-to-r from-pink-400 via-purple-300 to-cyan-400">
                    Portal of Randomness
                </h1>
                <p class="text-xs text-slate-400">Where endless curiosity meets total unexpected fun ✨</p>
            </div>
        </div>

        <div class="flex items-center gap-3 glass-card px-4 py-2 rounded-2xl">
            <button id="soundToggle" onclick="toggleSound()" class="p-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-700/50 transition" title="Toggle Sound FX">
                <i id="soundIcon" class="fa-solid fa-volume-high text-lg"></i>
            </button>
            <div class="h-6 w-px bg-slate-700"></div>
            <div class="flex items-center gap-2 text-sm font-semibold">
                <span class="text-slate-400">Rolls:</span>
                <span id="clickCounter" class="text-pink-400 font-bold font-fun text-lg">0</span>
            </div>
            <div class="h-6 w-px bg-slate-700"></div>
            <button onclick="clearHistory()" class="text-xs text-slate-400 hover:text-red-400 transition" title="Clear History">
                <i class="fa-solid fa-trash-can"></i>
            </button>
        </div>
    </header>

    <main class="relative z-10 flex-1 max-w-7xl mx-auto px-4 py-4 w-full flex flex-col gap-8">
        
        <div class="text-center max-w-2xl mx-auto space-y-2">
            <h2 class="text-3xl sm:text-4xl font-extrabold font-fun text-white">Choose Your Portal 🎯</h2>
            <p class="text-slate-300 text-sm">
                Explore secret websites, teleport in Street View, test our Akinator Mind Reader, or unleash weird audio & facts!
            </p>
        </div>

        <!-- PORTAL BUTTONS GRID -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 2xl:grid-cols-6 gap-5">
            
            <!-- PORTAL 1: Random Website -->
            <div class="glass-card rounded-3xl p-5 flex flex-col justify-between items-center text-center group hover:border-pink-500/50 transition-all duration-300">
                <div class="space-y-3 w-full">
                    <div class="w-16 h-16 mx-auto rounded-2xl bg-pink-500/10 border border-pink-500/30 flex items-center justify-center text-pink-400 text-2xl group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-globe"></i>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-pink-400 bg-pink-500/10 px-2.5 py-0.5 rounded-full border border-pink-500/20">Portal #1</span>
                        <h3 class="text-lg font-extrabold text-white font-fun mt-1.5">Random Website</h3>
                        <p class="text-slate-400 text-xs mt-1">Discover fascinating, safe & cool web projects.</p>
                    </div>
                </div>

                <button onclick="launchRandomWebsite()" class="glow-btn-1 w-full mt-5 py-3.5 px-4 rounded-xl font-fun text-sm font-bold text-white flex items-center justify-center gap-2">
                    <span>Teleport Web</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>

            <!-- PORTAL 2: Street View Teleport -->
            <div class="glass-card rounded-3xl p-5 flex flex-col justify-between items-center text-center group hover:border-cyan-500/50 transition-all duration-300">
                <div class="space-y-3 w-full">
                    <div class="w-16 h-16 mx-auto rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-2xl group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-compass"></i>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 px-2.5 py-0.5 rounded-full border border-cyan-500/20">Portal #2</span>
                        <h3 class="text-lg font-extrabold text-white font-fun mt-1.5">Street View</h3>
                        <p class="text-slate-400 text-xs mt-1">Jump to breathtaking & crazy places on Google Maps!</p>
                    </div>
                </div>

                <button onclick="launchRandomStreetView()" class="glow-btn-2 w-full mt-5 py-3.5 px-4 rounded-xl font-fun text-sm font-bold text-white flex items-center justify-center gap-2">
                    <span>Explore Spot</span>
                    <i class="fa-solid fa-street-view"></i>
                </button>
            </div>

            <!-- PORTAL 3: Goofy Sentence -->
            <div class="glass-card rounded-3xl p-5 flex flex-col justify-between items-center text-center group hover:border-emerald-500/50 transition-all duration-300">
                <div class="space-y-3 w-full">
                    <div class="w-16 h-16 mx-auto rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-2xl group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-face-grin-tears"></i>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">Portal #3</span>
                        <h3 class="text-lg font-extrabold text-white font-fun mt-1.5">Goofy Sentence</h3>
                        <p class="text-slate-400 text-xs mt-1">Nonsensical wisdom & random quote generator.</p>
                    </div>
                </div>

                <button onclick="generateGoofySentence()" class="glow-btn-3 w-full mt-5 py-3.5 px-4 rounded-xl font-fun text-sm font-bold text-white flex items-center justify-center gap-2">
                    <span>Generate Goof</span>
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                </button>
            </div>

            <!-- PORTAL 4: Akinator Mind Reader -->
            <div class="glass-card rounded-3xl p-5 flex flex-col justify-between items-center text-center group hover:border-purple-500/50 transition-all duration-300 border border-purple-500/20">
                <div class="space-y-3 w-full">
                    <div class="w-16 h-16 mx-auto rounded-2xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 text-2xl group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-brain"></i>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-purple-400 bg-purple-500/10 px-2.5 py-0.5 rounded-full border border-purple-500/20">Portal #4</span>
                        <h3 class="text-lg font-extrabold text-white font-fun mt-1.5">Akinator Genie</h3>
                        <p class="text-slate-400 text-xs mt-1">Think of a character & I'll guess who it is!</p>
                    </div>
                </div>

                <button onclick="openAkinatorModal()" class="glow-btn-4 w-full mt-5 py-3.5 px-4 rounded-xl font-fun text-sm font-bold text-white flex items-center justify-center gap-2">
                    <span>Play Akinator</span>
                    <i class="fa-solid fa-hat-wizard"></i>
                </button>
            </div>

            <!-- PORTAL 5: Weird Fact / Sound Synth -->
            <div class="glass-card rounded-3xl p-5 flex flex-col justify-between items-center text-center group hover:border-amber-500/50 transition-all duration-300">
                <div class="space-y-3 w-full">
                    <div class="w-16 h-16 mx-auto rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 text-2xl group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-lightbulb"></i>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-amber-400 bg-amber-500/10 px-2.5 py-0.5 rounded-full border border-amber-500/20">Portal #5</span>
                        <h3 class="text-lg font-extrabold text-white font-fun mt-1.5">Weird Facts</h3>
                        <p class="text-slate-400 text-xs mt-1">Bizarre & shocking real-world trivia.</p>
                    </div>
                </div>

                <button onclick="generateWeirdFact()" class="glow-btn-5 w-full mt-5 py-3.5 px-4 rounded-xl font-fun text-sm font-bold text-white flex items-center justify-center gap-2">
                    <span>Uncover Fact</span>
                    <i class="fa-solid fa-bolt"></i>
                </button>
            </div>

            <!-- PORTAL 6: Random Jokes & Puns -->
            <div class="glass-card rounded-3xl p-5 flex flex-col justify-between items-center text-center group hover:border-rose-500/50 transition-all duration-300">
                <div class="space-y-3 w-full">
                    <div class="w-16 h-16 mx-auto rounded-2xl bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-rose-400 text-2xl group-hover:scale-110 transition duration-300">
                        <i class="fa-solid fa-face-laugh-squint"></i>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-rose-400 bg-rose-500/10 px-2.5 py-0.5 rounded-full border border-rose-500/20">Portal #6</span>
                        <h3 class="text-lg font-extrabold text-white font-fun mt-1.5">Jokes & Puns</h3>
                        <p class="text-slate-400 text-xs mt-1">Hilarious one-liners, dad jokes & clever puns!</p>
                    </div>
                </div>

                <button onclick="generateRandomJoke()" class="glow-btn-6 w-full mt-5 py-3.5 px-4 rounded-xl font-fun text-sm font-bold text-white flex items-center justify-center gap-2">
                    <span>Tell Joke</span>
                    <i class="fa-solid fa-face-laugh-beam"></i>
                </button>
            </div>

        </div>

        <!-- WILDCARD / SURPRISE ME BAR -->
        <div class="glass-card p-5 rounded-3xl flex flex-col sm:flex-row items-center justify-between gap-4 border border-purple-500/30">
            <div class="flex items-center gap-4 text-center sm:text-left">
                <div class="w-12 h-12 rounded-2xl bg-purple-500/20 flex items-center justify-center text-purple-300 text-xl shrink-0 mx-auto sm:mx-0">
                    <i class="fa-solid fa-shuffle"></i>
                </div>
                <div>
                    <h4 class="font-fun text-base font-bold text-white">Can't decide? Try the Wildcard!</h4>
                    <p class="text-xs text-slate-400">Roll the cosmic wheel to launch a completely surprise experience.</p>
                </div>
            </div>
            <button onclick="triggerWildcard()" class="glow-wildcard px-8 py-3.5 rounded-2xl font-fun text-white font-bold hover:opacity-90 active:scale-95 transition shadow-lg w-full sm:w-auto shrink-0 text-sm">
                🎲 Surprise Me!
            </button>
        </div>

        <!-- DYNAMIC SENTENCE / FACT DISPLAY BANNER -->
        <div id="textOutputContainer" class="hidden speech-bubble glass-card p-6 rounded-3xl border border-emerald-500/40 relative overflow-hidden">
            <div id="outputAccentBar" class="absolute top-0 left-0 w-2 h-full bg-emerald-500"></div>
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div class="space-y-2 flex-1">
                    <div class="flex items-center gap-2 text-emerald-400 text-xs font-bold uppercase tracking-wider" id="outputBadge">
                        <i class="fa-solid fa-quote-left"></i>
                        <span>Freshly Baked Goofiness</span>
                    </div>
                    <p id="textOutput" class="text-xl sm:text-2xl font-fun font-bold text-slate-100 leading-snug">
                        "Loading sentence..."
                    </p>
                </div>
                <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
                    <button onclick="speakText()" class="p-3 bg-slate-800 hover:bg-slate-700 text-emerald-400 rounded-xl transition border border-slate-700" title="Read Aloud">
                        <i class="fa-solid fa-volume-high"></i>
                    </button>
                    <button onclick="copyText()" class="p-3 bg-slate-800 hover:bg-slate-700 text-emerald-400 rounded-xl transition border border-slate-700" title="Copy to Clipboard">
                        <i class="fa-solid fa-copy"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- HISTORY RECENT ROLLS -->
        <div class="glass-card p-6 rounded-3xl space-y-4">
            <div class="flex justify-between items-center">
                <h3 class="font-fun text-lg font-bold text-slate-200 flex items-center gap-2">
                    <i class="fa-solid fa-clock-rotate-left text-purple-400"></i>
                    Recent Portal Log
                </h3>
                <span class="text-xs text-slate-500" id="historyCount">0 items logged</span>
            </div>

            <div id="historyList" class="flex flex-col gap-2 max-h-56 overflow-y-auto pr-1">
                <p id="emptyHistoryMsg" class="text-center py-6 text-xs text-slate-500 italic">
                    No random journeys yet! Click any portal button above to log your adventures here.
                </p>
            </div>
        </div>

    </main>

    <!-- STREET VIEW MODAL -->
    <div id="streetViewModal" class="fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-black/85 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300">
        <div id="streetViewCard" class="glass-card w-full max-w-5xl rounded-3xl overflow-hidden flex flex-col h-[85vh] transition-all duration-300 border border-cyan-500/30">
            <!-- Modal Header -->
            <div class="px-5 py-3.5 border-b border-slate-800 flex justify-between items-center bg-slate-900/80 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <div>
                        <h3 id="modalLocTitle" class="font-fun font-bold text-white text-base sm:text-lg">Mysterious Location</h3>
                        <p id="modalLocCoords" class="text-[11px] text-slate-400">Lat: 0.00, Lng: 0.00</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="toggleStreetViewFullscreen()" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition" title="Toggle Fullscreen">
                        <i id="fsIcon" class="fa-solid fa-expand"></i>
                    </button>
                    <button onclick="closeStreetViewModal()" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>

            <!-- Modal Content - Street View Embed -->
            <div class="relative flex-1 bg-slate-950 w-full h-full overflow-hidden flex items-center justify-center">
                <iframe id="streetViewIframe" class="w-full h-full border-0" loading="lazy" allowfullscreen src=""></iframe>
            </div>

            <!-- Modal Footer -->
            <div class="px-5 py-3.5 bg-slate-900/80 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-center gap-3 shrink-0">
                <p id="modalLocDescription" class="text-xs text-slate-300 text-center sm:text-left">
                    Use mouse drag or touch to look around 360 degrees!
                </p>
                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <button onclick="launchRandomStreetView()" class="flex-1 sm:flex-none px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-dice"></i>
                        <span>Another Spot</span>
                    </button>
                    <a id="modalDirectLink" target="_blank" rel="noopener noreferrer" href="#" class="flex-1 sm:flex-none px-4 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-bold transition flex items-center justify-center gap-2 shadow-lg shadow-cyan-500/20">
                        <span>Open Maps</span>
                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- WEBSITE PREVIEW MODAL -->
    <div id="websiteModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="glass-card w-full max-w-lg rounded-3xl p-6 border border-pink-500/30 text-center space-y-5">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-pink-500/20 text-pink-400 flex items-center justify-center text-3xl">
                <i class="fa-solid fa-paper-plane"></i>
            </div>
            <div>
                <span id="webCategoryTag" class="text-xs font-bold text-pink-400 bg-pink-500/10 px-3 py-1 rounded-full border border-pink-500/20">Interactive Experience</span>
                <h3 id="webModalTitle" class="text-2xl font-extrabold font-fun text-white mt-2">Awesome Website</h3>
                <p id="webModalDesc" class="text-xs text-slate-300 mt-2 leading-relaxed">Description goes here...</p>
            </div>

            <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800 flex items-center justify-center text-xs font-mono text-pink-300 truncate" id="webModalUrl">
                https://example.com
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button onclick="closeWebsiteModal()" class="flex-1 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-fun text-sm font-bold transition">
                    Cancel
                </button>
                <a id="webModalLaunchBtn" target="_blank" rel="noopener noreferrer" href="#" onclick="closeWebsiteModal()" class="flex-1 py-3 rounded-xl bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-400 hover:to-purple-500 text-white font-fun text-sm font-bold shadow-lg shadow-pink-500/30 transition flex items-center justify-center gap-2">
